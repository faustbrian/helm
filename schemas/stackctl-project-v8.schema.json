{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackctl.dev/schemas/project/v8.json",
  "title": "Stackctl v8 project configuration",
  "description": "Desired local development services managed by Stackctl v8.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "services"
  ],
  "properties": {
    "schema_version": {
      "const": 8
    },
    "project": {
      "$ref": "#/$defs/dnsLabel"
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dnsLabel"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "preset"
          ]
        },
        {
          "required": [
            "image"
          ]
        }
      ],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "php_extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dnsLabel"
          }
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
