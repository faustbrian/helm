{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackctl.dev/schemas/project/v8.json",
  "title": "Stackctl v8 project configuration",
  "description": "Desired local development services managed by Stackctl v8.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "services"
  ],
  "properties": {
    "schema_version": {
      "const": 8
    },
    "project": {
      "$ref": "#/$defs/dnsLabel"
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/dnsLabel"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "immutableImage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-fA-F]{64}$"
    },
    "preset": {
      "type": "string",
      "enum": [
        "mongodb",
        "postgres",
        "pg",
        "pgsql",
        "mysql",
        "mariadb",
        "sqlserver",
        "mssql",
        "redis",
        "valkey",
        "dragonfly",
        "memcached",
        "minio",
        "garage",
        "localstack",
        "rustfs",
        "opensearch",
        "elasticsearch",
        "meilisearch",
        "typesense",
        "frankenphp",
        "laravel",
        "reverb",
        "horizon",
        "queue-worker",
        "queue",
        "scheduler",
        "dusk",
        "selenium",
        "gotenberg",
        "mailpit",
        "rabbitmq",
        "soketi"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "preset"
          ]
        },
        {
          "required": [
            "image"
          ]
        }
      ],
      "properties": {
        "preset": {
          "$ref": "#/$defs/preset"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "php_extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          }
        },
        "composer_image": {
          "$ref": "#/$defs/immutableImage"
        },
        "node_image": {
          "$ref": "#/$defs/immutableImage"
        },
        "bun_image": {
          "$ref": "#/$defs/immutableImage"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dnsLabel"
          }
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
